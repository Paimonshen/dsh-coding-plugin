{
  "name": "dsh-coding-plugin",
  "version": "1.0.0",
  "description": "代码学习插件 — DSH 动态 Cordis 插件：悬浮窗代码编辑器 / 多语言执行 / 课程关卡评判 / 进度笔记片段 / 分析直投对话",
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "coding",
    "learning",
    "deepseek"
  ],
  "license": "MIT",
  "main": "source/client.js",
  "files": [
    "source/",
    "src/",
    "tools/",
    "examples/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paimonshen/dsh-coding-plugin.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
